# ---------------------------------------------------------------- patient data
# Nothing derived from patient records belongs in this repository. The pipeline
# writes everything under output/ and scratch_home; both stay local.
output/
*.parquet
*.csv
*.png
*.pdf

# salt used to pseudonymize record numbers for cross-site transfer; keeping it
# out of git is what makes the pseudonyms non-reversible by a reader of the repo
.id_salt

# ------------------------------------------------------------ machine-specific
# names local data locations, which differ at every site
code/config/paths.yaml

# ------------------------------------------------------------------ environment
.venv/
.venv-stub-delete-me/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ------------------------------------------------------------------------ tooling
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------------------------------------------------------- federated export
# Bundles a site assembles for the coordinating site. They hold patient-level
# embeddings and are NOT de-identified; they move under a DUA, never through git.
# Anchored to the repository root: a bare `export/` would also match
# code/clifcs/export/, which is the contract itself and belongs in git.
/output/export/

# The three output tiers, named so that what may leave is obvious from the
# directory. None belongs in git: tier 1 because it is unreviewed until someone
# has checked the suppression, the other two because they are patient-level.
/output/patient_level_data_*/
/output/upload_to_box_*/
/output/token_level_data_*/
/output/received/
/scratch/
#ai folders
.claude
first_review.md
